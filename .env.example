PORT=3000
VECTOR_PROVIDER=pinecone

# Use separate 1024-dimension Pinecone indexes. Never commit real credentials.
PINECONE_API_KEY=
PINECONE_INDEX_english=
PINECONE_INDEX_nepali=
PINECONE_NAMESPACE=lawyersathi
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# Optional: enabled by default in the application for second-stage semantic reranking.
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# Optional overrides for the two native-language PDF folders.
# ENGLISH_PDF_SOURCE_DIR=C:\\Users\\user\\Desktop\\english files
# NEPALI_PDF_SOURCE_DIR=C:\\Users\\user\\Desktop\\nepali files

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Set true only on a machine that has both source-PDF folders and needs to reindex.
AUTO_REINDEX=false
